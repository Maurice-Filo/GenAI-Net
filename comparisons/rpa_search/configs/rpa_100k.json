{
  "benchmark": {
    "name": "rpa_102400_full",
    "task": "rpa",
    "output_root": "comparisons/rpa_search/data/raw",
    "figure_dir": "comparisons/rpa_search/figures",
    "x_field": "ode_simulations",
    "log_y": true,
    "plot_title": "RPA Search Progress",
    "aggregate_plot_title": "RPA Search Progress (3 seeds)",
    "plot_ylabel": "Best-so-far RPA loss",
    "min_ode_simulations": 102400,
    "plot_methods": [
      "random_search",
      "circuitree",
      "reaction_network_evolution_jl",
      "rl4crn"
    ],
    "plot_run_ids": [
      "rpa_full102400_seed0_parallel",
      "rpa_full102400_seed0_single",
      "rpa_full102400_seed0_cvode",
      "rpa_full102400_seed0",
      "rpa_full102400_seed1_parallel",
      "rpa_full102400_seed1_single",
      "rpa_full102400_seed1_cvode",
      "rpa_full102400_seed1",
      "rpa_full102400_seed2_parallel",
      "rpa_full102400_seed2_single",
      "rpa_full102400_seed2_cvode",
      "rpa_full102400_seed2"
    ],
    "plot_method_run_ids": {
      "random_search": ["rpa_full102400_seed0_parallel", "rpa_full102400_seed1_parallel", "rpa_full102400_seed2_parallel"],
      "circuitree": ["rpa_full102400_seed0_single", "rpa_full102400_seed1_single", "rpa_full102400_seed2_single"],
      "reaction_network_evolution_jl": ["rpa_full102400_seed0", "rpa_full102400_seed1", "rpa_full102400_seed2"],
      "rl4crn": ["rpa_full102400_seed0_cvode", "rpa_full102400_seed1_cvode", "rpa_full102400_seed2_cvode"]
    }
  },
  "rpa": {
    "species": ["X_1", "X_2", "X_3"],
    "production_input_map": {"X_1": "u_1"},
    "degradation_input_map": {"X_3": "u_2"},
    "output_species": "X_3",
    "solver": "LSODA",
    "rtol": 1e-8,
    "atol": 1e-8,
    "t_f": 100.0,
    "n_t": 1000,
    "ic": ["constant", 0.01],
    "weights": "transient",
    "u_values": [0.5, 1.0, 1.5],
    "library_order": 2
  },
  "search": {
    "seed": 0,
    "max_added_reactions": 5,
    "rate_constant_range": [0.1, 50.0],
    "random_workers": 32,
    "random_chunk_size": 64,
    "circuitree_workers": 1,
    "candidate_budget": 102400,
    "mcts_iterations": 102400,
    "mcts_exploration": 1.4
  },
  "rl4crn": {
    "epochs": 100,
    "batch_size": 1024,
    "n_cpus": 32,
    "render_every": 0,
    "policy_width": 256,
    "policy_depth": 2,
    "deep_layer_size": 512,
    "hall_of_fame_size": 30
  }
}
